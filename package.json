{
  "name": "decision-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/assemble.mjs && node scripts/build.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "dev": "node scripts/assemble.mjs && node scripts/dev.mjs",
    "test": "node scripts/assemble.mjs && node --test tests/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "test:live": "node scripts/live-check.mjs",
    "benchmark:fetch": "python3 scripts/benchmarks/fetch.py",
    "benchmark:verify": ".cache/benchmarks/venv/bin/python scripts/benchmarks/verify.py",
    "benchmark:setup": "node scripts/benchmarks/setup.mjs",
    "benchmark:clef": "node scripts/benchmarks/run-clef.mjs && node scripts/benchmarks/render-clef-report.mjs",
    "cli": "node bin/decision-lab.mjs"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "bin": {
    "decision-lab": "./bin/decision-lab.mjs"
  }
}
